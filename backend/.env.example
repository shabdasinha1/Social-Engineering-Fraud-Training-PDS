# Copy to .env for local development. Never commit a real .env.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cyber_awareness_training
CORS_ORIGIN=http://localhost:5173

# Signs the candidate session cookie. Change this for any real deployment: with
# NODE_ENV=production the server refuses to start while it still has this value.
SESSION_SECRET=local-development-session-secret-change-me
SESSION_MAX_AGE_MS=28800000

# Signs the admin session cookie. REQUIRED - the server will not start without it,
# and it must not equal SESSION_SECRET. There is deliberately no default value.
# Generate one locally, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Admin session lifetime. Shorter than the candidate session on purpose.
ADMIN_SESSION_MAX_AGE_MS=3600000

# Admin login throttling (failed attempts before lockout, window, lockout length).
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MS=900000
ADMIN_LOGIN_LOCKOUT_MS=900000

# Behind a reverse proxy on the SAME host (Nginx -> 127.0.0.1:5000) set TRUST_PROXY=loopback
# so the admin login throttle sees the real client address. Leave unset when the API is
# reached directly. See docs/PRODUCTION_DEPLOYMENT_LINUX.md.
# TRUST_PROXY=loopback
